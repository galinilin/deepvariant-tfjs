{
  "name": "dv-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DeepVariant 1.8 WGS — interactive p5 sandbox in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist --dotfiles --branch gh-pages --message 'deploy: deepvariant-tfjs site'"
  },
  "dependencies": {
    "@tensorflow/tfjs": "4.22.0",
    "@types/p5": "^1.7.7",
    "p5": "^2.2.3"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "typescript": "~5.6.0",
    "vite": "^5.4.0"
  }
}
