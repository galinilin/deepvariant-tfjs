{
  "name": "dv-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DeepVariant 1.8 WGS — interactive p5 sandbox in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sync-models": "bash scripts/sync-models.sh",
    "predeploy": "bash scripts/sync-models.sh uint8-only && npm run build",
    "deploy": "gh-pages -d dist --dotfiles --branch gh-pages --message 'deploy: deepvariant-tfjs site'",
    "match": "tsx scripts/match.ts",
    "extract-match-fixtures": "bash -c 'cd /root/dv-tfjs && uv run python /root/deepvariant-tf-js/scripts/extract_match_fixtures.py /root/deepvariant-tf-js/fixtures/match'"
  },
  "dependencies": {
    "@tensorflow/tfjs": "4.22.0",
    "@types/p5": "^1.7.7",
    "p5": "^2.2.3"
  },
  "devDependencies": {
    "@tensorflow/tfjs-node": "^4.22.0",
    "gh-pages": "^6.3.0",
    "tsx": "^4.19.2",
    "typescript": "~5.6.0",
    "vite": "^5.4.0"
  }
}
